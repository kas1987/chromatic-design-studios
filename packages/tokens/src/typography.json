{
  "family": {
    "heading": "Inter",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "scale": {
    "xs": { "size": "12px", "rem": "0.75rem", "lineHeight": "1.4", "letterSpacing": "0.05em" },
    "sm": { "size": "14px", "rem": "0.875rem", "lineHeight": "1.5", "letterSpacing": "0" },
    "base": { "size": "16px", "rem": "1rem", "lineHeight": "1.6", "letterSpacing": "0" },
    "lg": { "size": "18px", "rem": "1.125rem", "lineHeight": "1.4", "letterSpacing": "-0.01em" },
    "xl": { "size": "24px", "rem": "1.5rem", "lineHeight": "1.3", "letterSpacing": "-0.01em" },
    "2xl": { "size": "30px", "rem": "1.875rem", "lineHeight": "1.2", "letterSpacing": "-0.02em" },
    "3xl": { "size": "36px", "rem": "2.25rem", "lineHeight": "1.2", "letterSpacing": "-0.02em" },
    "4xl": { "size": "48px", "rem": "3rem", "lineHeight": "1.1", "letterSpacing": "-0.02em" }
  },
  "weight": {
    "normal": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "lineHeight": {
    "tight": 1.2,
    "snug": 1.3,
    "normal": 1.5,
    "relaxed": 1.6,
    "loose": 1.75
  },
  "letterSpacing": {
    "tight": "-0.02em",
    "normal": "0",
    "wide": "0.05em",
    "wider": "0.1em"
  },
  "role": {
    "display": { "size": "4xl", "weight": "bold", "lineHeight": "tight", "letterSpacing": "tight" },
    "h1": { "size": "3xl", "weight": "bold", "lineHeight": "tight", "letterSpacing": "tight" },
    "h2": { "size": "xl", "weight": "semibold", "lineHeight": "snug", "letterSpacing": "normal" },
    "h3": { "size": "lg", "weight": "semibold", "lineHeight": "normal", "letterSpacing": "normal" },
    "body": { "size": "base", "weight": "normal", "lineHeight": "relaxed", "letterSpacing": "normal" },
    "bodySmall": { "size": "sm", "weight": "normal", "lineHeight": "normal", "letterSpacing": "normal" },
    "label": { "size": "xs", "weight": "medium", "lineHeight": "normal", "letterSpacing": "wide" },
    "mono": { "size": "sm", "weight": "normal", "lineHeight": "normal", "letterSpacing": "normal" }
  }
}