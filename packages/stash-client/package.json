{
  "name": "@chromatic/stash-client",
  "version": "0.5.0",
  "description": "Typed GraphQL client for the ComfyUI-Harness Stash media library. Includes a deterministic mock client so CDS pages render offline.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "keywords": ["stash", "graphql", "media", "comfyui"],
  "license": "MIT"
}
