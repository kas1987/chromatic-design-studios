{
  "name": "chromatic-design-studios",
  "version": "0.1.0",
  "private": true,
  "description": "Chromatic Design Studios — local-first AI design and operations control center",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "db:build": "node scripts/build-db.mjs",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "node --experimental-strip-types apps/api/src/index.ts",
    "build:web": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "pretypecheck": "npm run tokens",
    "typecheck": "tsc --noEmit --project apps/web/tsconfig.json"
  },
  "dependencies": {
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.0.0"
  }
}
